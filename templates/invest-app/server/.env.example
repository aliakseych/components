DJANGO_SECRET_KEY=dev-insecure-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://invest:invest@localhost:5432/invest

# Product name used in AI prompts and MCP server info.
APP_NAME=Northwind Invest
# Opt-in: look up company cards on the public registry orginfo.uz (scrapes its search page).
ORGINFO_LOOKUP=false
CACHE_DIR=/tmp/invest-cache

# Общий OpenAI-совместимый провайдер ИИ инвестора и компании; только для API.
# BASE_URL — базовый адрес или полный путь /chat/completions.
# Основная модель обязательна, резервная необязательна. Храните ключ в server/.env.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODEL=
